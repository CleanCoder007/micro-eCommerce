# Stage 1: Build
FROM maven:3.9-eclipse-temurin-17-alpine AS builder

WORKDIR /build

COPY pom.xml .
COPY common ./common
COPY infrastructure/pom.xml ./infrastructure/
COPY infrastructure/config-server ./infrastructure/config-server/

RUN mvn clean package -DskipTests -pl infrastructure/config-server -am -q

# Stage 2: Runtime
FROM eclipse-temurin:17-jre-alpine

RUN apk add --no-cache curl \
    && addgroup -g 1000 appuser \
    && adduser -u 1000 -G appuser -s /sbin/nologin -D appuser

WORKDIR /app

COPY --from=builder --chown=appuser:appuser /build/infrastructure/config-server/target/config-server-*.jar app.jar
COPY --chown=appuser:appuser config-repo /app/config-repo

RUN chmod 550 /app && chmod 440 /app/app.jar

EXPOSE 8888

ENV SERVER_PORT=8888

USER appuser

HEALTHCHECK --interval=10s --timeout=5s --start-period=30s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:8888/actuator/health/readiness || exit 1

ENTRYPOINT ["java", "-XX:+UseG1GC", "-XX:MaxRAMPercentage=75.0", "-jar", "app.jar"]
