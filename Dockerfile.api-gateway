# Stage 1: Build
FROM maven:3.9-eclipse-temurin-17-alpine AS builder

WORKDIR /build

COPY pom.xml .
COPY common ./common
COPY infrastructure/pom.xml ./infrastructure/
COPY infrastructure/api-gateway ./infrastructure/api-gateway/

RUN mvn clean package -DskipTests -pl infrastructure/api-gateway -am -q

# Stage 2: Runtime
FROM eclipse-temurin:17-jre-alpine

RUN apk add --no-cache curl \
    && addgroup -g 1000 appuser \
    && adduser -u 1000 -G appuser -s /sbin/nologin -D appuser

WORKDIR /app

COPY --from=builder --chown=appuser:appuser /build/infrastructure/api-gateway/target/api-gateway-*.jar app.jar

RUN chmod 550 /app && chmod 440 /app/app.jar

EXPOSE 8080

ENV SERVER_PORT=8080

USER appuser

HEALTHCHECK --interval=10s --timeout=5s --start-period=30s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:8080/actuator/health/readiness || exit 1

ENTRYPOINT ["java", "-XX:+UseG1GC", "-XX:MaxRAMPercentage=75.0", "-jar", "app.jar"]
