# ============================================================
# eCommerce Microservices - Environment Configuration Template
# ============================================================
# Copy this file to .env and fill in the values for your environment

# ============================================================
# Database Configuration
# ============================================================
DB_HOST=postgres
DB_PORT=5432
DB_NAME=ecommerce
DB_USERNAME=postgres
DB_PASSWORD=your-secure-password-here

# ============================================================
# Redis Configuration
# ============================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password
REDIS_DB=0

# ============================================================
# Kafka Configuration
# ============================================================
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
KAFKA_BROKERS=kafka:9092
KAFKA_SASL_USERNAME=kafka
KAFKA_SASL_PASSWORD=kafka-password
KAFKA_SECURITY_PROTOCOL=PLAINTEXT

# ============================================================
# JWT Security
# ============================================================
JWT_SECRET=your-very-secure-jwt-secret-key-minimum-32-chars

# ============================================================
# Service Ports
# ============================================================
API_GATEWAY_PORT=8080
CUSTOMER_SERVICE_PORT=8081
ORDER_SERVICE_PORT=8082
INVENTORY_SERVICE_PORT=8082
PAYMENT_SERVICE_PORT=8084
DISCOVERY_SERVER_PORT=8761
CONFIG_SERVER_PORT=8888

# ============================================================
# Monitoring & Logging
# ============================================================
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
KIBANA_PORT=5601
ELASTICSEARCH_HOST=elasticsearch
ELASTICSEARCH_PORT=9200

# ============================================================
# Application Profiles
# ============================================================
# Possible values: dev, staging, prod
SPRING_PROFILES_ACTIVE=dev

# ============================================================
# Logging Configuration
# ============================================================
LOG_LEVEL=INFO
# Options: DEBUG, INFO, WARN, ERROR
LOG_FORMAT=json

# ============================================================
# External Services (if applicable)
# ============================================================
PAYMENT_GATEWAY_URL=https://api.payment-provider.com
PAYMENT_GATEWAY_API_KEY=your-api-key-here
EMAIL_SERVICE_URL=https://email-service.com
EMAIL_SERVICE_API_KEY=your-email-api-key

# ============================================================
# Docker Registry
# ============================================================
REGISTRY_URL=ghcr.io
REGISTRY_USERNAME=your-github-username
REGISTRY_PASSWORD=your-github-token

# ============================================================
# Kubernetes Configuration (for deployments)
# ============================================================
K8S_NAMESPACE=ecommerce-dev
K8S_CONTEXT=docker-desktop
# Options: docker-desktop, minikube, aws-eks, gke, aks, etc.

# ============================================================
# Feature Flags
# ============================================================
FEATURE_NEW_PAYMENT_GATEWAY=false
FEATURE_ADVANCED_ANALYTICS=false
FEATURE_FRAUD_DETECTION=true

# ============================================================
# Timeouts and Connection Settings
# ============================================================
CONNECTION_TIMEOUT=30000  # milliseconds
READ_TIMEOUT=60000        # milliseconds
WRITE_TIMEOUT=60000       # milliseconds

# ============================================================
# Cache Configuration
# ============================================================
CACHE_TTL=3600  # seconds
CACHE_ENABLED=true

# ============================================================
# Security Settings
# ============================================================
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CSRF_PROTECTION_ENABLED=true

# ============================================================
# Email Configuration (for notifications)
# ============================================================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_FROM=noreply@ecommerce.com

# ============================================================
# AWS Configuration (if using AWS services)
# ============================================================
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_S3_BUCKET=ecommerce-bucket

# ============================================================
# Backup Configuration
# ============================================================
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *  # Daily at 2 AM
BACKUP_RETENTION_DAYS=30

# ============================================================
# Audit Logging
# ============================================================
AUDIT_LOGGING_ENABLED=true
AUDIT_LOG_RETENTION_DAYS=90

# ============================================================
# Monitoring Alerts
# ============================================================
ALERT_EMAIL_RECIPIENTS=ops@ecommerce.com
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
PAGERDUTY_INTEGRATION_KEY=your-pagerduty-key
