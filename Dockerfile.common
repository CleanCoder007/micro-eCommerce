# Multi-stage build for shared build context
FROM maven:3.9-eclipse-temurin-17-alpine AS maven-builder

WORKDIR /build

COPY pom.xml .
COPY common ./common
COPY services/pom.xml ./services/
COPY infrastructure/pom.xml ./infrastructure/

RUN mvn clean install -DskipTests -f common/pom.xml -q

# Base image for services
FROM eclipse-temurin:17-jre-alpine

RUN apk add --no-cache curl \
    && addgroup -g 1000 appuser \
    && adduser -u 1000 -G appuser -s /sbin/nologin -D appuser

HEALTHCHECK --interval=10s --timeout=5s --start-period=30s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:${SERVER_PORT:-8080}/actuator/health/readiness || exit 1
